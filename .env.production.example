# 排班宝 TeamShift —— 生产环境变量
# 复制为 .env.production 后填写，切勿提交到代码仓库

# ============ 访问方式 ============
# 默认 http：直接使用 http://服务器IP，无需域名和证书
# 如需域名 HTTPS，改为 https 并填写下面的 DOMAIN 和 CERT_EMAIL
DEPLOY_SCHEME=http

# 可选：服务器公网 IP，仅用于部署完成后的地址提示，留空不影响部署
SERVER_IP=

# 仅 DEPLOY_SCHEME=https 时必填：已解析到服务器的真实域名和证书邮箱
DOMAIN=
CERT_EMAIL=

# ============ 排班参数 ============
# 随机种子：固定值保证同输入同结果，便于复现排班
SCHEDULE_SEED=42
# 登录态有效期（天）
SESSION_TTL_DAYS=30
# 轮转历史统计最近几个周期
HISTORY_PERIODS=6

# ============ 安全（生产建议全开）============
# 全局限流：单 IP 每分钟最多请求数
RATE_LIMIT_ENABLED=1
RATE_LIMIT_GLOBAL_PER_MIN=300
# 登录限流：单 IP + 工号 10 分钟内最多尝试次数
RATE_LIMIT_LOGIN_PER_10MIN=10
# 可选：HTTPS 网页排班提醒。各次部署使用同一对 VAPID 密钥。
WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
