# 排班宝 TeamShift —— 生产环境变量
# 复制为 .env.production 后填写，切勿提交到代码仓库

# ============ 必填 ============
# 你的域名（已备案，且已解析到本服务器 IP）
DOMAIN=shift.example.com

# 证书邮箱（Let's Encrypt 到期提醒用）
CERT_EMAIL=admin@example.com

# ============ 排班参数 ============
# 随机种子：固定值保证同输入同结果，便于复现排班
SCHEDULE_SEED=42
# 登录态有效期（天）
SESSION_TTL_DAYS=30
# 轮转历史统计最近几个周期
HISTORY_PERIODS=6

# ============ 安全（生产建议全开）============
# 全局限流：单 IP 每分钟最多请求数
RATE_LIMIT_ENABLED=1
RATE_LIMIT_GLOBAL_PER_MIN=300
# 登录限流：单 IP + 工号 10 分钟内最多尝试次数
RATE_LIMIT_LOGIN_PER_10MIN=10
