.page {
  min-height: 100vh;
  background: #F4F6FA;
  padding-bottom: 40rpx;
}

.topbar {
  background: #2E5AAC;
  padding: 24rpx 32rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.period-info {
  display: flex;
  flex-direction: column;
}

.p-name {
  font-size: 30rpx;
  font-weight: bold;
}

.p-range {
  font-size: 22rpx;
  opacity: 0.8;
}

.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 4rpx;
}

.tab {
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  border-radius: 10rpx;
  color: rgba(255, 255, 255, 0.75);
}

.tab.active {
  background: #fff;
  color: #2E5AAC;
  font-weight: bold;
}

.gap-banner {
  margin: 20rpx 32rpx 0;
  background: #FDECEC;
  color: #C0392B;
  border-radius: 14rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
}

.gap-num {
  font-weight: bold;
  font-size: 30rpx;
}

.matrix {
  padding: 20rpx 32rpx;
}

.day-card {
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.day-head {
  background: #F4F8FE;
  color: #2E5AAC;
  font-weight: bold;
  font-size: 28rpx;
  padding: 18rpx 28rpx;
}

.shift-block {
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #F0F2F5;
}

.shift-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.shift-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #374151;
}

.shift-time {
  font-size: 22rpx;
  color: #9CA3AF;
}

.wt-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.wt-name {
  display: flex;
  align-items: center;
  width: 200rpx;
  font-size: 24rpx;
  color: #374151;
  flex-shrink: 0;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.wt-people {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.person {
  background: #EEF2FB;
  color: #2E5AAC;
  border-radius: 10rpx;
  padding: 8rpx 18rpx;
  font-size: 24rpx;
}

.person.mine {
  background: #2E5AAC;
  color: #fff;
  font-weight: bold;
}

.count-tag {
  font-size: 22rpx;
  color: #8A94A6;
  background: #F3F4F6;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
}

.gap-badge {
  background: #FDECEC;
  color: #C0392B;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #9CA3AF;
  font-size: 26rpx;
}
