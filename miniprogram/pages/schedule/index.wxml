<view class="page">
  <!-- 周期信息 + tab -->
  <view class="topbar">
    <view class="period-info" wx:if="{{period}}">
      <text class="p-name">{{period.name}}</text>
      <text class="p-range">{{period.startDate}} ~ {{period.endDate}}</text>
    </view>
    <view class="tabs">
      <button class="tab {{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="switchTab">个人视角</button>
      <button class="tab {{tab === 'team' ? 'active' : ''}}" data-tab="team" bindtap="switchTab">团队视角</button>
      <button class="tab {{tab === 'work' ? 'active' : ''}}" data-tab="work" bindtap="switchTab">工作类型</button>
    </view>
  </view>

  <view class="schedule-filters">
    <picker range="{{ranges}}" value="{{range}}" bindchange="onRange"><view class="schedule-picker">{{ranges[range]}} ▾</view></picker>
    <picker wx:if="{{tab === 'work' && !loading && !error && workTypes.length}}" range="{{workTypes}}" range-key="name" value="{{workIndex}}" bindchange="onWork">
      <view class="schedule-picker">{{workTypes[workIndex].name}} ▾</view>
    </picker>
    <text class="p-range" wx:if="{{dateRange}}">{{dateRange}}</text>
  </view>
  <view class="matrix" wx:if="{{days.length}}">
    <view class="day-card" wx:for="{{days}}" wx:key="date" wx:for-item="day">
      <view class="day-head">{{day.label}}<text wx:if="{{tab !== 'mine'}}"> · {{day.people.length}} 人</text></view>
      <view class="team-person" wx:for="{{day.people}}" wx:key="id" wx:for-item="person">
        <view class="team-name">{{person.name}}<text wx:if="{{person.mine}}"> · 我</text></view>
        <view class="team-jobs">
          <view class="team-job" wx:for="{{person.jobs}}" wx:key="id" wx:for-item="job" data-assignment-id="{{job.id}}" data-user-id="{{person.id}}" bindtap="onTapAssignment">
            <text>{{job.workTypeName}}{{job.roleLabel ? ' · ' + job.roleLabel : ''}}</text>
            <text class="team-meta">{{job.shiftName}} · {{job.startTime}}–{{job.endTime}} · {{job.periodName}}</text>
            <text class="team-meta" wx:if="{{job.peers}}">同伴：{{job.peers}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 缺口提示 -->
  <view class="gap-banner" wx:if="{{gaps && gaps.totalGap > 0}}">
    <text class="gap-num">{{gaps.totalGap}}</text> 个班次缺口待补
  </view>

  <!-- 矩阵 -->
  <view class="matrix" wx:if="{{filtered.length}}">
    <view class="day-card" wx:for="{{filtered}}" wx:key="workDate" wx:for-item="day">
      <view class="day-head">{{day.dateLabel}}</view>
      <view class="shift-block" wx:for="{{day.shifts}}" wx:key="shiftId" wx:for-item="shift">
        <view class="shift-head">
          <text class="shift-name">{{shift.shiftName}}</text>
        </view>
        <view class="wt-row" wx:for="{{shift.workTypes}}" wx:key="workTypeId" wx:for-item="wt">
          <view class="wt-name">
            <view class="dot" style="background: {{wt.workTypeColor}}"></view>
            <text>{{wt.workTypeName}}</text>
          </view>
          <view class="wt-people">
            <view
              class="person {{a.userId === myId ? 'mine' : ''}}"
              wx:for="{{wt.assigned}}"
              wx:key="id"
              wx:for-item="a"
              data-assignment-id="{{a.id}}"
              data-user-id="{{a.userId}}"
              bindtap="onTapAssignment"
            >{{a.name}}{{a.dutyRole === 'primary' ? '·主' : a.dutyRole === 'deputy' ? '·副' : ''}}</view>
            <view class="count-tag" wx:if="{{wt.needCount > 1}}">{{wt.filled}}/{{wt.needCount}}</view>
            <view class="gap-badge" wx:if="{{wt.gap > 0}}">缺{{wt.gap}}</view>
            <view class="gap-badge" wx:for="{{wt.roleGaps}}" wx:key="*this" wx:for-item="role">缺{{role === 'primary' ? '主负责人' : '副负责人'}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !days.length && !filtered.length}}">
    <text>{{error || (tab === 'mine' ? '这段时间暂无我的安排' : tab === 'work' ? (workTypes.length ? '这段时间该工作暂无排班' : '暂无可查看的工作类型') : '这段时间暂无团队排班')}}</text>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
