.page {
  min-height: 100vh;
  background: #F4F6FA;
  padding-bottom: 40rpx;
}

.header {
  background: #2E5AAC;
  padding: 40rpx 40rpx 100rpx;
  color: #fff;
}

.greet {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.hello {
  font-size: 38rpx;
  font-weight: bold;
}

.role {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
}

.date {
  font-size: 24rpx;
  opacity: 0.85;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  margin: -60rpx 32rpx 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(31, 41, 55, 0.06);
}

.main-card {
  margin-top: -60rpx;
}

.period-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.period-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1F2937;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.status-enrolling { background: #E8F5EE; color: #2E9E5B; }
.status-scheduling { background: #FFF4E5; color: #D97706; }
.status-published { background: #E8F0FE; color: #2E5AAC; }
.status-draft { background: #F3F4F6; color: #6B7280; }
.status-archived { background: #F3F4F6; color: #9CA3AF; }

.next-shift {
  background: #F4F8FE;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.ns-label {
  font-size: 22rpx;
  color: #8A94A6;
  display: block;
  margin-bottom: 8rpx;
}

.ns-date {
  font-size: 34rpx;
  font-weight: bold;
  color: #2E5AAC;
  display: block;
}

.ns-detail {
  font-size: 26rpx;
  color: #374151;
  display: block;
  margin-top: 6rpx;
}

.count-row {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 20rpx;
}

.num {
  color: #2E5AAC;
  font-weight: bold;
}

.empty-tip {
  color: #9CA3AF;
  font-size: 26rpx;
  padding: 20rpx 0 28rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
}

.btn-ghost {
  background: #fff;
  border: 2rpx solid #2E5AAC;
  color: #2E5AAC;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.btn-primary-sm {
  background: #2E5AAC;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.empty-card {
  text-align: center;
  color: #9CA3AF;
  font-size: 26rpx;
  padding: 60rpx 32rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 0 32rpx;
  margin-top: 12rpx;
}

.grid-item {
  width: calc((100% - 48rpx) / 3);
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.gi-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #fff;
  margin-bottom: 12rpx;
}

.gi-icon.swap { background: #E8834A; }
.gi-icon.enroll { background: #3FAE7E; }
.gi-icon.admin { background: #9B6BC4; }
.gi-icon.sched { background: #4A90D9; }

.gi-label {
  font-size: 24rpx;
  color: #374151;
}

.badge {
  position: absolute;
  top: 12rpx;
  right: 20rpx;
  background: #E74C3C;
  color: #fff;
  border-radius: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  padding: 0 8rpx;
}

.stats-card {
  margin-top: 8rpx;
}

.sc-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #1F2937;
}

.sc-row {
  display: flex;
  justify-content: space-around;
}

.sc-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sc-num {
  font-size: 34rpx;
  font-weight: bold;
  color: #2E5AAC;
}

.sc-label {
  font-size: 22rpx;
  color: #8A94A6;
  margin-top: 4rpx;
}
