.page {
  min-height: 100vh;
  background: #F4F6FA;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1F2937;
}

.subtitle {
  font-size: 26rpx;
  color: #8A94A6;
  margin: 12rpx 0 48rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
}

.field {
  margin-bottom: 36rpx;
}

.label {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
  display: block;
}

.input {
  height: 88rpx;
  background: #F4F6FA;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
}

.btn-primary {
  margin-top: 16rpx;
  height: 92rpx;
  line-height: 92rpx;
  background: #2E5AAC;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  border: none;
}

.btn-primary.disabled {
  opacity: 0.6;
}
