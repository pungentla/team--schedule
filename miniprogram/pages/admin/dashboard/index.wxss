.page { min-height: 100vh; background: #F4F6FA; padding: 24rpx 32rpx; box-sizing: border-box; }

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat {
  width: calc((100% - 20rpx) / 2);
  background: #fff;
  border-radius: 18rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat .v { font-size: 40rpx; font-weight: bold; color: #2E5AAC; }
.stat .l { font-size: 24rpx; color: #8A94A6; margin-top: 6rpx; }

.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.c-row { display: flex; justify-content: space-between; align-items: center; }
.c-name { font-size: 30rpx; font-weight: bold; color: #1F2937; }
.c-status { font-size: 24rpx; color: #D97706; }
.c-range { font-size: 24rpx; color: #8A94A6; margin-top: 8rpx; display: block; }

.m-row { display: flex; gap: 20rpx; margin-top: 28rpx; }

.m-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background: #F4F6FA;
  color: #374151;
  font-size: 26rpx;
}

.m-item.primary { background: #2E5AAC; color: #fff; }

.menu-item {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F6F8;
  font-size: 28rpx;
  color: #1F2937;
}

.menu-item:last-child { border-bottom: none; }

.arr { color: #C0C4CC; font-size: 34rpx; }
