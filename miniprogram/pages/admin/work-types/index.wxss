.page { min-height: 100vh; background: #F4F6FA; padding: 24rpx 32rpx; }
.add { background: #2E5AAC; color: #fff; border-radius: 14rpx; font-size: 28rpx; margin-bottom: 24rpx; }
.item {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  display: flex; align-items: center; gap: 20rpx; margin-bottom: 16rpx;
}
.dot { width: 28rpx; height: 28rpx; border-radius: 50%; flex-shrink: 0; }
.info { flex: 1; }
.name { font-size: 28rpx; font-weight: bold; color: #1F2937; display: block; }
.code { font-size: 22rpx; color: #9CA3AF; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 10; }
.form { width: 600rpx; background: #fff; border-radius: 20rpx; padding: 36rpx; }
.f-title { font-size: 32rpx; font-weight: bold; margin-bottom: 24rpx; }
.f-field { display: flex; align-items: center; margin-bottom: 20rpx; gap: 16rpx; }
.f-field text { width: 90rpx; font-size: 26rpx; color: #6B7280; flex-shrink: 0; }
.f-field input { flex: 1; height: 76rpx; background: #F4F6FA; border-radius: 10rpx; padding: 0 20rpx; font-size: 28rpx; }
.save { background: #2E5AAC; color: #fff; border-radius: 12rpx; font-size: 28rpx; margin-top: 8rpx; }
