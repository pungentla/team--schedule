<view class="page">
  <button class="add" bindtap="openCreate">+ 新增工作类型</button>

  <view class="item" wx:for="{{items}}" wx:key="id">
    <view class="dot" style="background: {{item.color}}"></view>
    <view class="info" data-id="{{item.id}}" bindtap="openEdit">
      <text class="name">{{item.name}}</text>
      <text class="code">{{item.code}} · 报名 {{item.enrolledCount}} 人</text>
    </view>
    <switch checked="{{item.active}}" data-id="{{item.id}}" bindchange="toggleActive" color="#2E5AAC" />
  </view>

  <view class="mask" wx:if="{{showForm}}" bindtap="closeForm">
    <view class="form" catchtap="">
      <view class="f-title">{{editing ? '编辑' : '新增'}}工作类型</view>
      <view class="f-field"><text>编码</text><input value="{{form.code}}" disabled="{{!!editing}}" data-field="code" bindinput="onForm" placeholder="如 FRONT" /></view>
      <view class="f-field"><text>名称</text><input value="{{form.name}}" data-field="name" bindinput="onForm" placeholder="如 前台接待" /></view>
      <view class="f-field"><text>颜色</text><input value="{{form.color}}" data-field="color" bindinput="onForm" /></view>
      <view class="f-field"><text>排序</text><input type="number" value="{{form.sortOrder}}" data-field="sortOrder" bindinput="onForm" /></view>
      <view class="f-field"><text>每班至少 1 主 + 1 副</text><switch checked="{{form.requiresRoles}}" data-field="requiresRoles" bindchange="onForm" color="#2E5AAC" /></view>
      <view class="f-field"><text>开放工作日</text><checkbox-group bindchange="onWeekdays"><label wx:for="{{weekdays}}" wx:key="value"><checkbox value="{{item.value}}" checked="{{item.checked}}" />{{item.label}}</label></checkbox-group></view>
      <view class="f-field"><text>每班默认人数</text><input type="number" value="{{form.defaultNeed}}" data-field="defaultNeed" bindinput="onForm" /></view>
      <view wx:if="{{form.requiresRoles}}">
        <view class="f-title">固定搭档轮值</view><view class="code">可配置多组，人员可重复。两人需有本期或长期报名；留空不限制搭配。</view>
        <view class="rule" wx:for="{{pairs}}" wx:key="index" wx:for-index="pairIndex">
          <picker range="{{employees}}" range-key="label" value="{{item.primaryIndex}}" data-index="{{pairIndex}}" data-field="primaryUserId" bindchange="onPair"><view>主：{{item.primaryIndex >= 0 ? employees[item.primaryIndex].label : '选择人员'}} ▾</view></picker>
          <picker range="{{employees}}" range-key="label" value="{{item.deputyIndex}}" data-index="{{pairIndex}}" data-field="deputyUserId" bindchange="onPair"><view>副：{{item.deputyIndex >= 0 ? employees[item.deputyIndex].label : '选择人员'}} ▾</view></picker>
          <button size="mini" data-index="{{pairIndex}}" bindtap="removePair">移除此组</button>
        </view><button bindtap="addPair" disabled="{{employees.length < 2}}">＋ 添加主副搭档</button>
      </view>
      <view class="f-title">长期固定人员</view><view class="code">跨周期自动生效，无需重复报名。同一天可添加多位员工；到需求页应用工作日规则可补足人数。</view>
      <view class="rule" wx:for="{{rules}}" wx:key="index" wx:for-index="ruleIndex">
        <picker range="{{dayNames}}" value="{{item.weekday}}" data-index="{{ruleIndex}}" data-field="weekday" bindchange="onRule"><view>{{dayNames[item.weekday]}} ▾</view></picker>
        <picker range="{{shifts}}" range-key="name" value="{{item.shiftIndex}}" data-index="{{ruleIndex}}" data-field="shiftId" bindchange="onRule"><view>{{item.shiftIndex >= 0 ? shifts[item.shiftIndex].name : '班次已停用，请重选'}} ▾</view></picker>
        <picker range="{{employees}}" range-key="label" value="{{item.userIndex}}" data-index="{{ruleIndex}}" data-field="userId" bindchange="onRule"><view>{{item.userIndex >= 0 ? employees[item.userIndex].label : '人员已停用，请重选'}} ▾</view></picker>
        <picker wx:if="{{form.requiresRoles}}" range="{{roleNames}}" value="{{item.roleIndex}}" data-index="{{ruleIndex}}" data-field="dutyRole" bindchange="onRule"><view>{{roleNames[item.roleIndex]}} ▾</view></picker>
        <button size="mini" data-index="{{ruleIndex}}" bindtap="removeRule">移除此人</button>
      </view><button disabled="{{!shifts.length || !employees.length}}" bindtap="addRule">＋ 添加固定人员</button>
      <button class="save" bindtap="onSave">保存</button>
    </view>
  </view>
</view>
