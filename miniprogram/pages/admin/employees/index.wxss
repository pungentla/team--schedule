.page { min-height: 100vh; background: #F4F6FA; padding: 24rpx 32rpx; }
.sec-title { font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; color: #1F2937; }
.sec-title.mt { margin-top: 32rpx; }
.user { background: #fff; border-radius: 14rpx; padding: 22rpx; margin-bottom: 12rpx; display: flex; justify-content: space-between; align-items: center; }
.name { font-size: 27rpx; font-weight: bold; display: block; }
.meta { font-size: 22rpx; color: #9CA3AF; }
.ops { display: flex; gap: 12rpx; }
.op { font-size: 22rpx; padding: 8rpx 16rpx; border-radius: 8rpx; background: #F4F6FA; color: #374151; }
.op.danger { background: #FDECEC; color: #C0392B; }
.op.ok { background: #E8F5EE; color: #2E9E5B; }
.add { background: #2E5AAC; color: #fff; border-radius: 14rpx; font-size: 26rpx; margin-bottom: 16rpx; }
.invite { background: #fff; border-radius: 14rpx; padding: 22rpx; margin-bottom: 12rpx; display: flex; justify-content: space-between; align-items: center; }
.code { font-size: 30rpx; font-weight: bold; color: #2E5AAC; font-family: monospace; display: block; }
.copy { font-size: 22rpx; color: #2E5AAC; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; z-index: 10; }
.form { width: 600rpx; background: #fff; border-radius: 20rpx; padding: 36rpx; }
.f-title { font-size: 32rpx; font-weight: bold; margin-bottom: 24rpx; }
.f-field { display: flex; align-items: center; margin-bottom: 20rpx; gap: 16rpx; }
.f-field text { width: 130rpx; font-size: 26rpx; color: #6B7280; flex-shrink: 0; }
.f-field input { flex: 1; height: 76rpx; background: #F4F6FA; border-radius: 10rpx; padding: 0 20rpx; font-size: 28rpx; }
.save { background: #2E5AAC; color: #fff; border-radius: 12rpx; font-size: 28rpx; }
.user { flex-wrap: wrap; gap: 16rpx; }
.ops { flex-wrap: wrap; }
.form { max-height: 80vh; overflow-y: auto; }
.f-field input { min-width: 0; }
