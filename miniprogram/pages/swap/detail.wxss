.page {
  min-height: 100vh;
  background: #F4F6FA;
  padding-bottom: 200rpx;
}

.status-bar {
  padding: 36rpx 32rpx;
  color: #fff;
}

.status-bar.status-pending { background: #D97706; }
.status-bar.status-approved { background: #2E9E5B; }
.status-bar.status-rejected,
.status-bar.status-cancelled { background: #9CA3AF; }

.st-label { font-size: 36rpx; font-weight: bold; display: block; }
.st-sub { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; display: block; }

.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx;
  margin: 24rpx 32rpx;
}

.c-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #1F2937;
}

.c-title.warn { color: #C0392B; }

.assign-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.assign-box {
  flex: 1;
  background: #F9FAFB;
  border-radius: 14rpx;
  padding: 20rpx;
}

.ab-label { font-size: 22rpx; color: #8A94A6; display: block; margin-bottom: 8rpx; }
.ab-body { font-size: 27rpx; color: #1F2937; font-weight: bold; display: block; white-space: pre-line; }
.ab-user { font-size: 22rpx; color: #6B7280; margin-top: 6rpx; display: block; }

.arrow { font-size: 40rpx; color: #2E5AAC; font-weight: bold; }

.msg {
  margin-top: 20rpx;
  background: #FFF8E8;
  border-radius: 12rpx;
  padding: 18rpx;
  font-size: 25rpx;
  color: #92400E;
}

.warn-card { border: 2rpx solid #F5C6CB; }

.prob {
  color: #C0392B;
  font-size: 25rpx;
  padding: 8rpx 0;
}

.part {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F5F6F8;
}

.part:last-child { border-bottom: none; }

.p-name { font-size: 27rpx; color: #1F2937; font-weight: bold; margin-right: 12rpx; }
.p-role { font-size: 22rpx; color: #8A94A6; }

.p-status { font-size: 24rpx; }
.p-status.s-approved { color: #2E9E5B; }
.p-status.s-pending { color: #D97706; }
.p-status.s-rejected { color: #C0392B; }

.tl { padding: 10rpx 0; display: flex; gap: 16rpx; font-size: 24rpx; }
.tl-time { color: #9CA3AF; flex-shrink: 0; }
.tl-text { color: #374151; }

.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn-ghost {
  flex: 1;
  background: #fff;
  border: 2rpx solid #C0C4CC;
  color: #6B7280;
  border-radius: 14rpx;
  font-size: 30rpx;
}

.btn-ghost.full { width: 100%; }

.btn-primary {
  flex: 2;
  background: #2E5AAC;
  color: #fff;
  border-radius: 14rpx;
  font-size: 30rpx;
}
