.page {
  min-height: 100vh;
  background: #F4F6FA;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.tab {
  position: relative;
  padding: 26rpx 0;
  margin-right: 48rpx;
  font-size: 28rpx;
  color: #6B7280;
}

.tab.on {
  color: #2E5AAC;
  font-weight: bold;
  border-bottom: 4rpx solid #2E5AAC;
}

.badge {
  position: absolute;
  top: 12rpx;
  right: -32rpx;
  background: #E74C3C;
  color: #fff;
  border-radius: 16rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 20rpx;
}

.list { padding: 24rpx 32rpx; }

.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.i-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.i-type {
  background: #EEF2FB;
  color: #2E5AAC;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.i-status { font-size: 22rpx; }
.s-pending { color: #D97706; }
.s-approved { color: #2E9E5B; }
.s-rejected, .s-cancelled { color: #9CA3AF; }

.i-body { flex: 1; }

.i-line {
  display: block;
  font-size: 28rpx;
  color: #1F2937;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.i-people {
  font-size: 24rpx;
  color: #6B7280;
}

.i-arrow {
  color: #C0C4CC;
  font-size: 36rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}
