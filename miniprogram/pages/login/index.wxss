.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #2E5AAC 0%, #4A7BC8 30%, #F4F6FA 60%);
  padding: 120rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.logo-text {
  font-size: 72rpx;
  color: #fff;
  font-weight: bold;
}

.app-name {
  font-size: 44rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.name-origin {
  margin-top: 8rpx;
  text-align: center;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(46, 90, 172, 0.08);
}

.field {
  margin-bottom: 36rpx;
}

.label {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
  display: block;
}

.input {
  height: 88rpx;
  background: #F4F6FA;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
}

.btn-primary {
  margin-top: 16rpx;
  height: 92rpx;
  line-height: 92rpx;
  background: #2E5AAC;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  border: none;
}

.btn-primary.disabled {
  opacity: 0.6;
}

.register-link {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #8A94A6;
}

.link {
  color: #2E5AAC;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.panel {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: #1F2937;
}

.server-input {
  margin-bottom: 16rpx;
}

.quick-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.quick-btn {
  flex: 1;
  background: #EEF2FB;
  color: #2E5AAC;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  font-size: 22rpx;
  text-align: center;
  word-break: break-all;
}

.tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #9CA3AF;
  line-height: 1.5;
}

/* 服务器地址入口（显式可点，不再只靠长按） */
.server-entry {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  max-width: 100%;
}

.server-entry-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  max-width: 400rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.server-entry-btn {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
  flex-shrink: 0;
}

.panel-sub {
  font-size: 24rpx;
  color: #8A94A6;
  margin: -12rpx 0 24rpx;
}

.tip.warn {
  color: #C0392B;
  background: #FDECEC;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
