<view class="page">
  <view class="profile card">
    <view class="avatar">{{user.name[0]}}</view>
    <view class="p-info">
      <text class="p-name">{{user.name}}</text>
      <text class="p-no">工号 {{user.employeeNo}} · {{user.role === 'super_admin' ? '超级管理员' : (user.role === 'admin' ? '管理员' : '员工')}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{nicknameOpen}}">
    <view class="c-title">设置花名</view>
    <text class="password-help">花名保存后 30 天可再更改。可随时启用或禁用，禁用时显示姓名。</text>
    <text wx:if="{{nicknameLocked}}" class="password-help">下次可设置时间 {{nicknameAvailableAt}}</text>
    <form bindsubmit="submitNickname">
      <view class="password-field"><text>花名</text><input name="nickname" value="{{user.nickname || ''}}" maxlength="32" disabled="{{nicknameLocked || nicknameSaving}}" placeholder="输入花名" /></view>
      <text class="password-error" wx:if="{{nicknameError}}">{{nicknameError}}</text>
      <button form-type="submit" type="primary" loading="{{nicknameSaving}}" disabled="{{nicknameLocked || nicknameSaving}}">保存花名</button>
      <button wx:if="{{user.nickname}}" bindtap="toggleNicknameEnabled" disabled="{{nicknameSaving}}">{{user.nicknameEnabled ? '禁用花名' : '启用花名'}}</button>
      <button bindtap="toggleNickname" disabled="{{nicknameSaving}}">取消</button>
    </form>
  </view>

  <!-- 我的工作分布 -->
  <view class="card" wx:if="{{stats && stats.byWorkType.length}}">
    <view class="c-title">我的工作分布（共 {{stats.total}} 班）</view>
    <view class="wt-bar-row" wx:for="{{stats.byWorkType}}" wx:key="workTypeId">
      <text class="wt-bar-name">{{item.name}}</text>
      <view class="bar-wrap">
        <view class="bar" style="width: {{item.ratio * 100}}%; background: {{item.color}}"></view>
      </view>
      <text class="wt-bar-count">{{item.count}}次</text>
    </view>
  </view>

  <!-- 我的近期班次 -->
  <view class="card" wx:if="{{myShifts.length}}">
    <view class="c-title">我的班次（最近 {{myShifts.length}} 个）</view>
    <view class="shift-line" wx:for="{{myShifts}}" wx:key="id">
      <text class="sl-date">{{item.workDate}}</text>
      <text class="sl-detail">{{item.shiftName}} {{item.startTime}}-{{item.endTime}} · {{item.workTypeName}}{{item.dutyRole === 'primary' ? ' · 主负责人' : item.dutyRole === 'deputy' ? ' · 副负责人' : ''}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{passwordOpen}}">
    <view class="c-title">修改密码</view>
    <form bindsubmit="changePassword">
      <view class="password-field"><text>原密码</text><input name="oldPassword" password maxlength="128" disabled="{{passwordSaving}}" placeholder="输入原密码" /></view>
      <view class="password-field"><text>新密码</text><input name="newPassword" password maxlength="128" disabled="{{passwordSaving}}" placeholder="6–128 位" /></view>
      <view class="password-field"><text>确认新密码</text><input name="confirmPassword" password maxlength="128" disabled="{{passwordSaving}}" placeholder="再次输入新密码" /></view>
      <text class="password-help">修改后需重新登录。</text>
      <text class="password-error" wx:if="{{passwordError}}">{{passwordError}}</text>
      <button form-type="submit" type="primary" loading="{{passwordSaving}}" disabled="{{passwordSaving}}">保存新密码</button>
      <button bindtap="togglePassword" disabled="{{passwordSaving}}">取消</button>
    </form>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="toggleNickname"><text>设置花名</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="togglePassword"><text>修改密码</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goEnroll">
      <text>报名排班</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goSwapList">
      <text>换班申请</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="copyServer">
      <text>服务器地址</text>
      <text class="server-url">{{baseUrl}}</text>
    </view>
    <view class="menu-item danger" bindtap="onLogout">
      <text>退出登录</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
